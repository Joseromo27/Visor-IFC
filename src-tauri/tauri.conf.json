{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Visor IFC",
  "version": "0.1.0",
  "identifier": "cl.len.visorifc",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Visor IFC",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "LEN",
    "copyright": "LEN",
    "category": "Utility",
    "shortDescription": "Visor de archivos IFC",
    "longDescription": "Visor de modelos IFC4 con conversion a Fragments, arbol jerarquico y consulta de propiedades.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Joseromo27/Visor-IFC/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCN0VERjA2REREN0YzMDQKUldRRTg5ZmRCdDkrUzNaQWppZjVXWmk5OUpzNFE3My9nR3VJZHpSdm4waFVhdlpjTEV6a0g4bXcK"
    }
  }
}
